# Copy to .env.local and fill in. .env.local is gitignored — never commit real keys.
#
# Find these in the Supabase dashboard under Project Settings → API keys.

# --- public: bundled into the browser, protected by Row Level Security -------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# The "publishable" key (sb_publishable_…). Public by design.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# --- server only: NEVER commit, never send to the browser --------------------
# The "secret" key (sb_secret_…). BYPASSES Row Level Security.
SUPABASE_SECRET_KEY=sb_secret_replace_me

# Shared secret for the scheduled jobs in docs/05 § Background jobs.
CRON_SECRET=

# Optional
SENTRY_DSN=
